# Names used by every script. Change LOCATION if your Azure for Students subscription does not allow it.
RG=rg-fraud-azureml
WS=mlw-fraud-azureml
LOCATION=uksouth
COMPUTE=cpu-cluster
TRAIN_VM=Standard_DS3_v2          # 4 vCPU, 14 GB; scales to zero when idle
ENDPOINT_VM=Standard_DS2_v2       # 2 vCPU, 7 GB; billed while the endpoint exists, so delete it after testing
MODEL_NAME=fraud-xgb
DATA_NAME=paysim-raw
